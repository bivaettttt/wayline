{
  "components": {
    "schemas": {
      "Change": {
        "properties": {
          "actual_arr": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Arr"
          },
          "actual_dep": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Dep"
          },
          "estimated_arr": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Arr"
          },
          "estimated_dep": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Dep"
          },
          "event_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Event Id",
            "type": "string"
          },
          "flight": {
            "title": "Flight",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1000000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "source_time": {
            "format": "date-time",
            "title": "Source Time",
            "type": "string"
          },
          "status": {
            "default": "SCHEDULED",
            "enum": [
              "SCHEDULED",
              "CHECK_IN",
              "BOARDING",
              "DEPARTED",
              "IN_AIR",
              "LANDED",
              "ARRIVED",
              "CANCELLED",
              "DIVERTED",
              "UNKNOWN"
            ],
            "title": "Status",
            "type": "string"
          },
          "terminal_arr": {
            "default": "A",
            "maxLength": 12,
            "title": "Terminal Arr",
            "type": "string"
          },
          "terminal_dep": {
            "default": "A",
            "maxLength": 12,
            "title": "Terminal Dep",
            "type": "string"
          }
        },
        "required": [
          "flight"
        ],
        "title": "Change",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Mode": {
        "properties": {
          "mode": {
            "enum": [
              "normal",
              "unavailable",
              "slow",
              "invalid"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "Mode",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Wayline Synthetic Flight Provider",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/control/events": {
      "post": {
        "operationId": "emit_control_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Emit"
      }
    },
    "/control/mode": {
      "post": {
        "operationId": "mode_control_mode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Mode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mode"
      }
    },
    "/control/replay/{sequence}": {
      "post": {
        "operationId": "replay_control_replay__sequence__post",
        "parameters": [
          {
            "in": "path",
            "name": "sequence",
            "required": true,
            "schema": {
              "title": "Sequence",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replay"
      }
    },
    "/events": {
      "get": {
        "operationId": "poll_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Poll"
      }
    },
    "/flights/{flight}": {
      "get": {
        "operationId": "status_flights__flight__get",
        "parameters": [
          {
            "in": "path",
            "name": "flight",
            "required": true,
            "schema": {
              "title": "Flight",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Status"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/schedule": {
      "get": {
        "operationId": "catalog_schedule_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Catalog"
      }
    }
  }
}
