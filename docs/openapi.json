{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "NewUser": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "title": "Login",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "TRAVELER",
              "OPERATIONS_ANALYST",
              "ADMIN"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password",
          "name",
          "role"
        ],
        "title": "NewUser",
        "type": "object"
      },
      "Policy": {
        "additionalProperties": false,
        "properties": {
          "domestic": {
            "maximum": 240.0,
            "minimum": 15.0,
            "title": "Domestic",
            "type": "integer"
          },
          "international": {
            "maximum": 240.0,
            "minimum": 15.0,
            "title": "International",
            "type": "integer"
          },
          "terminal_extra": {
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Terminal Extra",
            "type": "integer"
          }
        },
        "required": [
          "domestic",
          "international",
          "terminal_extra"
        ],
        "title": "Policy",
        "type": "object"
      },
      "Search": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "pattern": "^[A-Z]{3}$",
            "title": "Destination",
            "type": "string"
          },
          "earliest": {
            "format": "date-time",
            "title": "Earliest",
            "type": "string"
          },
          "max_hours": {
            "default": 36,
            "maximum": 72.0,
            "minimum": 1.0,
            "title": "Max Hours",
            "type": "integer"
          },
          "max_legs": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Max Legs",
            "type": "integer"
          },
          "origin": {
            "pattern": "^[A-Z]{3}$",
            "title": "Origin",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "destination",
          "earliest"
        ],
        "title": "Search",
        "type": "object"
      },
      "Trip": {
        "additionalProperties": false,
        "properties": {
          "flights": {
            "items": {
              "pattern": "^[A-Za-z0-9_.-]{1,100}$",
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Flights",
            "type": "array"
          },
          "title": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "flights"
        ],
        "title": "Trip",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
